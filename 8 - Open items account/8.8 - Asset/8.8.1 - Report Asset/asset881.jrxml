		<defaultValueExpression><![CDATA["HH:mm"]]></defaultValueExpression>
	</parameter>
	<parameter name="LANDSCAPE_FOOTER_IMAGE" class="java.io.InputStream"/>
	<parameter name="DateTo" class="java.util.Date"/>
	<queryString>
		<![CDATA[select 
1 as ordervalue,
'Valore di carico' as TipoMov,
ac.name AS ClientName, 
org.name as OrgName,
ag.NAME as AssetGrpName,
a.assetservicedate,
a.value as AssetCod,
a.name as AssetName,
case when ad.A_Accumulated_Depr_Adjust='Y'
	then ad.DATEDOC
	else ad.DATEACCT 
end as DATEACCT,
ad.A_QTY_CURRENT AS QTY,
coalesce(ad.ASSETAMTENTERED,0) AS MovVal,
coalesce(ad.ASSETVALUEAMT,0) as AssetValue,
adw.a_current_period,
adw.a_period_1,
CASE WHEN a.isfullydepreciated ='Y' THEN 0
WHEN adw.a_current_period <= adw.a_period_1 THEN (adw.A_Asset_Cost/100/PercentUtilization)*(lit_over_depreciation/100) ELSE (adw.A_Asset_Cost*Percent)/100*(lit_over_depreciation)/100 END as  OverDeprAmt,
adw.UseLifeYears_F,
(adw.A_Asset_Cost)/(100/PercentUtilization*A_Period_1)  as A_Expense_SL,
(adw.A_Asset_Cost)/(100/PercentUtilization) as DepreciationAmt_Per1,
(adw.A_Asset_Cost)/(100/Percent) as DepreciationAmt,
adw.A_Accumulated_Depr ,
adw.A_Asset_Remaining,
CASE WHEN AG.isdepreciated='N' aND AG.isfixedasset='Y' THEN ADW.A_Asset_Cost END as QNADPR,
LIT_Over_Depreciation,
0 AS DispVal,
0 AS PlusMisusVal,
0 as AccumDeprUse,
0 As EvalSval,
0 AS IndedExpense,
disp.A_Disposal_Amt
 from A_Asset a
 LEFT JOIN A_Depreciation_Workfile adw ON a.A_Asset_ID=ADW.A_Asset_ID
	LEFT JOIN A_Asset_Addition ad ON ad.A_ASSET_ID = a.A_ASSET_ID
	LEFT JOIN A_Asset_Group AG ON a.A_ASSET_GROUP_ID = AG.A_ASSET_GROUP_ID
	LEFT JOIN AD_Client ac ON ac.AD_CLIENT_ID = a.AD_CLIENT_ID
	LEFT JOIN AD_Org org ON org.AD_ORG_ID = a.AD_ORG_ID
	LEFT JOIN C_Invoice ON C_Invoice.C_Invoice_ID = ad.C_Invoice_ID
	LEFT JOIN C_BPartner ON C_BPartner.C_BPARTNER_ID = C_Invoice.C_BPARTNER_ID
   LEFT JOIN	A_Asset_Disposed disp on a.a_asset_id=disp.a_asset_id

where  a.AD_CLIENT_ID = $P{AD_CLIENT_ID}
and  a.AD_ORG_ID = $P{AD_Org_ID}
and a.ISOWNED = 'Y'
and a.ISACTIVE = 'Y'
and a.A_ASSET_STATUS <> 'NW'
and (case when ad.A_Accumulated_Depr_Adjust='Y' then ad.DATEDOC else ad.DATEACCT end) <= $P{DateTo}
and (disp.A_Asset_Disposed_ID IS NULL OR disp.A_Disposed_Date >= $P{DateTo})
order by assetgrpname, assetcod, dateacct, ordervalue]]>
	</queryString>
